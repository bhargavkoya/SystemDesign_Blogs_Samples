{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sharding": {
    "ShardCount": 3,
    "ChunkCount": 200,
    "CapacityBytesPerShard": 5000000,
    "BytesPerCheckIn": 300,
    "BytesPerIndexEntry": 40,
    "AlertRatio": 0.8,
    "ScatterTimeoutMs": 250
  }
}

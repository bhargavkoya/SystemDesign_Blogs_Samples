{
  "Logging": { "LogLevel": { "Default": "Warning", "Balancer": "Information" } },
  "Balancer": {
    "Backends": [ "http://localhost:5101", "http://localhost:5102", "http://localhost:5103" ],
    "Strategy": "LeastConnections",
    "HealthIntervalMs": 1000,
    "HealthTimeoutMs": 500,
    "FailThreshold": 2,
    "PassThreshold": 2,
    "PanicThresholdPercent": 50,
    "MaxAttempts": 2,
    "RequestTimeoutMs": 2000
  }
}

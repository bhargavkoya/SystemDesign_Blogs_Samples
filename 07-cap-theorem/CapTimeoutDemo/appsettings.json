{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Policies": {
    "Operations": {
      "stock":   { "Mode": "Refuse",         "TimeoutMs": 300 },
      "catalog": { "Mode": "AnswerStale",    "TimeoutMs": 300 },
      "report":  { "Mode": "WaitThenRefuse", "TimeoutMs": 300, "MaxWaitMs": 2000, "RetryDelayMs": 200 }
    }
  }
}
